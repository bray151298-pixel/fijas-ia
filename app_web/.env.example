# ==========================================================================
# FIJAS IA — VARIABLES DE ENTORNO (server.ts / app_web)
# Nombres EXACTOS que el código lee (process.env.*). NO commitear valores reales.
# ==========================================================================

# --- TELEGRAM BOT TOKENS ---
# El código lee: SIGNALS = TELEGRAM_BOT_TOKEN (o SIGNALS_BOT_TOKEN como fallback)
#                SUPPORT = SUPPORT_BOT_TOKEN (o TELEGRAM_SUPPORT_BOT_TOKEN como fallback)
# OJO: "TELEGRAM_SIGNALS_BOT_TOKEN" NO se lee nunca — usa TELEGRAM_BOT_TOKEN.
TELEGRAM_BOT_TOKEN=your_signals_bot_token_here
SUPPORT_BOT_TOKEN=your_support_bot_token_here

# --- TELEGRAM CHANNELS & ADMIN ID (IDs reales SOLO en .env local, jamás commiteados) ---
TELEGRAM_PUBLIC_CHANNEL=@FijasIAOficial
TELEGRAM_VIP_CHANNEL_ID=your_vip_channel_id_here
VIP_CHANNEL_INVITE_LINK=
ADMIN_TELEGRAM_ID=your_admin_telegram_id_here

# --- TELEGRAM SAFETY (PRE-F00) ---
# OK = operación normal. Cualquier otro valor (COMPROMISED, etc.) => FAIL CLOSED: ningún bot arranca.
TELEGRAM_COMPROMISE_STATUS=OK
# Directorio de locks single-instance de polling (evita 409 por doble poller).
TELEGRAM_LOCK_DIR=data/locks

# --- ADMIN AUTH (FAIL CLOSED: sin estos valores, /api/admin/* responde 500) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=set_a_strong_password_here
ADMIN_RECOVERY_KEY=set_a_strong_recovery_key_here

# --- BASE DE DATOS (PostgreSQL primary source of truth) ---
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- HTTP ---
# Render inyecta PORT automáticamente; en local por defecto 3000.
PORT=3000
# CORS: orígenes propios separados por coma (backend FastAPI).
ALLOWED_ORIGINS=https://fijas-ia.onrender.com

# --- AI (OPCIONAL — solo contexto/redacción, NUNCA probabilidades/EV/stake) ---
GEMINI_API_KEY=your_gemini_api_key_here
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=your_omniroute_api_key_here
OMNIROUTE_MODEL=deepseek-chat
