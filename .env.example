# --- Datos ---
API_FOOTBALL_KEY=tu_api_key_de_rapidapi_aqui
API_FOOTBALL_HOST=api-football-v1.p.rapidapi.com

# --- Base de datos ---
# Dev: SQLite por defecto
DATABASE_URL=sqlite:///./tipster.db
# Prod: Postgres
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/tipster

# --- Banca y riesgo ---
INITIAL_BANKROLL=1000
KELLY_FRACTION=0.25
MAX_STAKE_PCT=0.02
MIN_PROBABILITY=0.60
MIN_EXPECTED_VALUE=0.05
DAILY_STOP_LOSS_PCT=0.05
DRAWDOWN_THRESHOLD_PCT=0.20

# --- IA (Análisis cualitativo con LLM) ---
# Opción 1: OmniRoute Proxy Local (localhost:20128)
AI_PROVIDER=omniroute
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=tu_clave_de_omniroute
OMNIROUTE_MODEL=deepseek-chat

# Opción 2: Google Gemini (Directo)
# GOOGLE_API_KEY=
# GOOGLE_MODEL=gemini-3.6-flash

# Opción 3: Anthropic Claude (Directo)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Alertas ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Operación ---
ENVIRONMENT=development
LOG_LEVEL=INFO
MODEL_ARTIFACTS_DIR=backend/app/ml/artifacts
