# TELEGRAM BOT TOKENS
TELEGRAM_SIGNALS_BOT_TOKEN=your_signals_bot_token_here
TELEGRAM_SUPPORT_BOT_TOKEN=your_support_bot_token_here

# TELEGRAM CHANNELS & ADMIN ID (usar IDs reales SOLO en .env local, nunca commiteados)
TELEGRAM_PUBLIC_CHANNEL=@FijasIAOficial
TELEGRAM_VIP_CHANNEL_ID=your_vip_channel_id_here
ADMIN_TELEGRAM_ID=your_admin_telegram_id_here

# AI INFERENCE / GEMINI / OMNIROUTE
GEMINI_API_KEY=your_gemini_api_key_here
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=your_omniroute_api_key_here
OMNIROUTE_MODEL=deepseek-chat

# PORT
PORT=3000
